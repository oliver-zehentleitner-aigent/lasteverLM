# Build-time configuration. Copy to .env.local for local development.

# Base URL of the API gateway baked into the build; empty means same origin
# (the deployed case). Leave empty when using VITE_DEV_PROXY.
API_BASE_URL=

# Dev server only: forward /api/* to this target, e.g. a local account
# service on :8000 or an ingress. Not used in the build.
VITE_DEV_PROXY=http://localhost:8000

# Run the admin page against an in-memory mock instead of /api/account/admin.
VITE_ADMIN_MOCK=false
