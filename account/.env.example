# PostgreSQL (Vultr Managed PostgreSQL in production), shared by all services
DATABASE_URL=postgresql://user:password@host:5432/lasteverlm

# Session tokens: HS256 secret, at least 32 random bytes; ingest and rag verify with the same value
AUTH_JWT_SECRET=

# Where the magic link in the mail points: <PUBLIC_BASE_URL>/auth/callback?token=...
PUBLIC_BASE_URL=https://lasteverlm.example.org

# Optional: shared demo token, resolves to the seeded demo user. Unset in production.
#DEMO_TOKEN=

# Comma-separated addresses that are admins and may log in regardless of the domain allowlist
ADMIN_EMAILS=

# Seed values only: copied into the settings table on first start, edited in the admin panel afterwards
AUTH_ALLOWED_DOMAINS=example.org
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM_ADDRESS=noreply@example.org
#SMTP_STARTTLS=true

# Optional tuning (core's rate-limit middleware: RATE_LIMIT_PER_MINUTE=120, BLOCK_MINUTES=15,
# BAN_AFTER_STRIKES=3, STRIKE_WINDOW_HOURS=24, ACCESS_LOG_HEALTHZ_SAMPLE=100)
#MAGIC_LINK_TTL_MINUTES=15
#JWT_TTL_DAYS=7
#VOUCHER_DEFAULT_CENTS=1000
#VISIT_RETENTION_DAYS=30
#TRUST_PROXY_HEADERS=true
#LOG_LEVEL=INFO
