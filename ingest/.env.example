# Vultr Managed PostgreSQL with the pgvector extension
DATABASE_URL=postgresql://user:password@host:5432/lasteverlm?sslmode=require

# Vultr Object Storage (S3-compatible)
S3_ENDPOINT=https://ewr1.vultrobjects.com
S3_BUCKET=lasteverlm-sources
S3_ACCESS_KEY=
S3_SECRET_KEY=
#S3_REGION=us-east-1

# Vultr Serverless Inference (OpenAI-compatible). Same embedding model as the rag service.
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
LLM_MODEL=                               # writes the per-source summary
#LLM_MAX_TOKENS=1024
# cents per million tokens; required for EMBEDDING_MODEL and LLM_MODEL until core ships defaults
MODEL_PRICES={"<embedding-model>": {"in": 2, "out": 0}, "<llm-model>": {"in": 30, "out": 150}}

# At least one of the two
DEMO_TOKEN=
#AUTH_JWT_SECRET=                        # both may be set; JWT is checked first

# Optional
#MAX_UPLOAD_BYTES=20971520
#CHUNK_TOKENS=                 # unset: core's chunker default
#CHUNK_OVERLAP_TOKENS=
#EMBED_BATCH_SIZE=64
#WORKER_POLL_SECONDS=2         # how often an idle worker looks for work
#CLAIM_TIMEOUT_SECONDS=600     # a claim not refreshed for this long is taken over by another worker
#SUMMARY_INPUT_TOKENS=6000
#SUMMARY_MAX_TOKENS=300
#IMAGE_MAX_TOKENS=2000         # one image or PDF page read by the vision model
#PDF_VISION_MAX_PAGES=100      # more pages for the vision model fail the source before any call
#SEED_DEMO_LIBRARY=true        # the four demo sources for every new user, paid by the demo user
#LOG_LEVEL=INFO
